{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todoimplementer.local/contracts/common.schema.json",
  "title": "Shared definitions",
  "description": "Defs referenced by every other contract. Times are epoch seconds (number). Costs are USD numbers.",
  "$defs": {
    "id8": {"type": "string", "pattern": "^[A-Za-z0-9]{8}$", "description": "First 8 chars of the todo-app note id."},
    "epoch": {"type": "number", "minimum": 0},
    "usd": {"type": "number", "minimum": 0},
    "assignee": {"enum": ["human", "claude"]},
    "stage": {
      "enum": ["spec", "spec_wait", "plan", "implement", "live_check", "checks", "gate", "shipping", "shipped", "closing", "closed", "failed", "paused_limit", "paused_retry", "cancelled"],
      "description": "Run stage as written by the runner. See DOCS-spec.md for transitions."
    },
    "status": {
      "enum": ["backlog", "yours", "cancelled", "queued", "working", "paused_limit", "shipping", "waiting_phone_update", "needs_you", "ready_to_ship", "ready_to_close", "done"],
      "description": "THE single status, computed on the server by board.status.compute. Never recomputed in the page."
    },
    "column": {"enum": ["backlog", "running", "needs_you", "ready", "done"]},
    "needs_kind": {
      "enum": [
        "spec_questions",
        "spec_ok",
        "claude_question",
        "claude_action",
        "phone",
        "checks_failed",
        "run_failed",
        "handed_to_you",
        "permission"
      ]
    },
    "needs": {
      "type": ["object", "null"],
      "description": "Why the task is in Needs you; null in every other column. text names exactly what is needed.",
      "properties": {
        "kind": {"$ref": "#/$defs/needs_kind"}, "text": {"type": "string", "minLength": 1},
        "category": {"enum": ["questions", "criteria", "action", "auto", "phone", "permission"], "description": "auto: the server heals it itself. phone: waiting for the phone."},
        "command": {"type": "string", "minLength": 1, "description": "permission only: the one-line command that grants it (works from any directory)."},
        "effort": {"type": "integer", "minimum": 1, "description": "Server-computed answers or clicks needed (open questions count one each); Least effort sorts by it, ascending, across repos."}
      },
      "required": ["kind", "text", "category", "effort"],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "description": "A button the page may show. enabled=false needs a reason; the page renders it disabled with the reason.",
      "properties": {
        "id": {
          "enum": [
            "start", "spec-answers", "spec-ok", "send", "ship", "close", "cancel", "lesson-approve",
            "copy-resume", "go", "copy-fix", "rerun"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "confirm": {"type": "boolean", "description": "Page asks 'sure?' first (ship, cancel)."},
        "value": {"type": "string", "description": "copy-resume and copy-fix only: the text to copy."},
        "option": {
          "type": "object",
          "description": "start (Start/Restart) only: a checkbox sent with the click; disabled needs a reason.",
          "properties": {
            "id": {"enum": ["auto_ship"]},
            "label": {"type": "string", "minLength": 1},
            "enabled": {"type": "boolean"},
            "reason": {"type": ["string", "null"]}
          },
          "required": ["id", "label", "enabled", "reason"],
          "additionalProperties": false,
          "if": {"properties": {"enabled": {"const": false}}},
          "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
        }
      },
      "required": ["id", "label", "enabled", "reason"],
      "additionalProperties": false,
      "if": {"properties": {"enabled": {"const": false}}},
      "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
    },
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "question": {
      "type": "object",
      "description": "Spec-stage card: Claude's open question and its recommended answer.",
      "properties": {
        "id": {"type": "string", "pattern": "^Q[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string"},
        "recommendation": {"type": "string"},
        "answer": {"type": ["string", "null"]}
      },
      "required": ["id", "title", "body", "recommendation", "answer"],
      "additionalProperties": false
    },
    "lesson": {
      "type": "object",
      "description": "Lesson drafted on a gate rejection; written to a skill only after the approve click.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "skill": {"type": "string", "minLength": 1},
        "mistake": {"type": "string"},
        "rule": {"type": "string"},
        "evidence": {"type": "string"},
        "state": {"enum": ["drafted", "approved", "rejected"]}
      },
      "required": ["id", "skill", "mistake", "rule", "evidence", "state"],
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "description": "Claude plan limit. until=null when none is active. credits: the paced free API credits (the pace, and the route a new turn takes while the limit holds).",
      "properties": {
        "active": {"type": "boolean"},
        "until": {"anyOf": [{"$ref": "#/$defs/epoch"}, {"type": "null"}]},
        "credits": {"$ref": "https://todoimplementer.local/contracts/credits.schema.json#/$defs/credits"}
      },
      "required": ["active", "until", "credits"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {"enum": ["bad_request", "forbidden", "not_found", "disabled", "conflict", "internal", "upstream_unavailable"]},
        "message": {"type": "string", "minLength": 1}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "id_list": {"type": "array", "items": {"type": "string"}},
    "partial": {
      "type": ["object", "null"],
      "description": "Live-check outcome when criteria are open or deferred to after the ship; else null.",
      "properties": {"done": {"$ref": "#/$defs/id_list"}, "open": {"$ref": "#/$defs/id_list"}, "deferred": {"$ref": "#/$defs/id_list"}, "followup_id": {"type": ["string", "null"]}},
      "required": ["done", "open", "deferred", "followup_id"],
      "additionalProperties": false
    },
    "tier_badges": {
      "type": "object",
      "description": "Cheap-tier badges (DOCS-tiers.md): cheap = Sonnet manager; free = free models allowed for the latest implement turn; escalated = Opus took over.",
      "properties": {"cheap": {"type": "boolean"}, "free": {"type": "boolean"}, "escalated": {"type": "boolean"}},
      "required": ["cheap", "free", "escalated"], "additionalProperties": false
    },
    "task_card": {
      "type": "object",
      "description": "One board card; also the head of the task detail.",
      "properties": {
        "id": {"$ref": "#/$defs/item_id"},
        "title": {"type": "string", "minLength": 1},
        "repo": {"type": ["string", "null"], "description": "null: the note has no repo, so it is in Yours."},
        "priority": {"type": "string"},
        "assignee": {"$ref": "#/$defs/assignee"},
        "stage": {"anyOf": [{"$ref": "#/$defs/stage"}, {"type": "null"}], "description": "null before a run."},
        "status": {"$ref": "#/$defs/status"},
        "column": {"$ref": "#/$defs/column"},
        "current": {"type": "string", "description": "One line on what it does or waits on, e.g. 'review round 2/5'."},
        "needs": {"$ref": "#/$defs/needs"},
        "partial": {"$ref": "#/$defs/partial"},
        "cost_usd": {"$ref": "#/$defs/usd"},
        "route": {"enum": ["plan", "credits", null], "description": "Route of the run's latest turn: plan (Max subscription) or credits (free API credits, badge on the card); null before a turn."},
        "parts": {"$ref": "https://todoimplementer.local/contracts/repotask.schema.json#/$defs/parts"},
        "waits_on": {"anyOf": [{"$ref": "#/$defs/item_id"}, {"type": "null"}], "description": "A queued card that waits on another run of the same repo (DOCS-repotask.md, per-repo lock): that run's id."},
        "tier": {"$ref": "#/$defs/tier_badges"}, "umbrella": {"$ref": "https://todoimplementer.local/contracts/umbrella.schema.json#/$defs/counts"},
        "resumes_at": {"anyOf": [{"$ref": "#/$defs/epoch"}, {"type": "null"}]},
        "updated": {"anyOf": [{"$ref": "#/$defs/epoch"}, {"type": "null"}]},
        "actions": {"$ref": "#/$defs/actions"},
        "auto_start": {"anyOf": [{"$ref": "#/$defs/auto_start"}, {"type": "null"}], "description": "Set when a passing done_check started this run (a closing run); kept after Close."},
        "auto": {"type": ["string", "null"], "description": "Backlog cards with a done_check while auto close is on: the latest poll's one-line reason."},
        "app_error": {"type": "integer", "minimum": 1, "description": "Optional: how many tickets of the errors loop (`Error-Signature:` lines, DOCS-errors.md) the card holds."}
      },
      "required": [
        "id", "title", "repo", "priority", "assignee", "stage", "status", "column", "current", "needs",
        "partial", "cost_usd", "route", "tier", "resumes_at", "updated", "actions", "auto_start", "auto"
      ],
      "additionalProperties": false
    },
    "auto_start": {
      "type": "object",
      "description": "Why a run started without a click: its trusted done_check passed at passed_at.",
      "properties": {"reason": {"const": "done_check"}, "passed_at": {"$ref": "#/$defs/epoch"}},
      "required": ["reason", "passed_at"], "additionalProperties": false
    },
    "item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{8}-[0-9]+$",
      "description": "Card id: <note id8>-<0-based index of the note's '## ' section>, or <repo hash8>-0 for a repo task (DOCS-repotask.md). Also the run-dir name."
    },
    "checks": {
      "type": "object",
      "description": "Latest Checks stage record: done_check, tests, linters. passed = every exit is 0. The last results' tails are the evidence close_task gets.",
      "properties": {
        "passed": {"type": "boolean"},
        "ran_at": {"$ref": "#/$defs/epoch"},
        "log": {"type": "string", "description": "Combined log path relative to the run dir."},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "exit": {"type": "integer"},
              "tail": {"type": "string", "description": "Last lines of the output."}
            },
            "required": ["command", "exit", "tail"],
            "additionalProperties": false
          }
        }
      },
      "required": ["passed", "ran_at", "results"],
      "additionalProperties": false
    },
    "self_check": {
      "type": "array",
      "description": "The implementer's own walk through plan.md's acceptance criteria (its final turn). Informational, never proof.",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "done": {"type": "boolean"},
          "note": {"type": "string"}
        },
        "required": ["criterion", "done"],
        "additionalProperties": false
      }
    },
    "live_check": {
      "type": "object",
      "description": "Record of the live_check stage: Claude ran the changed app/CLI/server and reports what it saw per criterion. Tests and code reading do not count. Shown at the gate and passed to close_task with the checks tails.",
      "properties": {
        "report_md": {"type": "string", "description": "What was run, what was seen, per criterion."},
        "shots": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Screenshot paths relative to the run dir (may be empty)."
        }
      },
      "required": ["report_md", "shots"],
      "additionalProperties": false
    }
  }
}
