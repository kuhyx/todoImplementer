{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todoimplementer.local/contracts/response.schema.json",
  "title": "POST /api/task/<item-id>/<action> response",
  "description": "ok:true (HTTP 200) returns the updated card. ok:false carries the HTTP status: 400 bad_request, 403 forbidden (Origin or token), 404 not_found, 409 disabled (the action is not enabled; message is its reason) or conflict, 500 internal.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {"const": true},
        "task": {"$ref": "https://todoimplementer.local/contracts/common.schema.json#/$defs/task_card"}
      },
      "required": ["ok", "task"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "POST /api/settings/credits-fallback: the fresh credits object.",
      "properties": {
        "ok": {"const": true},
        "credits": {"$ref": "https://todoimplementer.local/contracts/credits.schema.json#/$defs/credits"}
      },
      "required": ["ok", "credits"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "POST /api/new-task: the note that got the section, whether Start ran (false: the card is already at work or cannot start; its actions say why), and the repo's card (absent for a repo-less note, which triage files: T2347).",
      "properties": {
        "ok": {"const": true},
        "note": {"type": "string", "pattern": "^[A-Za-z0-9]{8}$"},
        "started": {"type": "boolean"},
        "task": {"$ref": "https://todoimplementer.local/contracts/common.schema.json#/$defs/task_card"}
      },
      "required": ["ok", "note", "started"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "POST /api/upload: the staged file's id (for new_task `files`), its cleaned name and size in bytes.",
      "properties": {
        "ok": {"const": true},
        "upload": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "size": {"type": "integer", "minimum": 0}
          },
          "required": ["id", "name", "size"],
          "additionalProperties": false
        }
      },
      "required": ["ok", "upload"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {"const": false},
        "error": {"$ref": "https://todoimplementer.local/contracts/common.schema.json#/$defs/error"}
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    }
  ]
}
