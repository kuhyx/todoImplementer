{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todoimplementer.local/contracts/autonomy.schema.json",
  "title": "Autonomy metrics",
  "description": "How much of the work ran without kuhy; Ship is not an intervention. `backfilled` counts cards that predate the intervention record and were rebuilt from state.json, events.jsonl and turn results.",
  "$defs": {
    "metric": {
      "type": "object",
      "description": "One autonomy metric: its value, the target to steer to and which way is better.",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "number"
        },
        "direction": {
          "enum": [
            "up",
            "down"
          ]
        },
        "weekly": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "week": {
                "type": "string",
                "pattern": "^\\d{4}-W\\d{2}$"
              },
              "value": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "week",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "value",
        "target",
        "direction",
        "weekly"
      ],
      "additionalProperties": false
    },
    "rate_metric": {
      "type": "object",
      "description": "Percent of finished cards (shipped or Done) that needed no intervention; value is null until a card finished.",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "finished": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "number"
        },
        "direction": {
          "enum": [
            "up",
            "down"
          ]
        },
        "weekly": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "week": {
                "type": "string",
                "pattern": "^\\d{4}-W\\d{2}$"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "finished": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "week",
              "value",
              "count",
              "finished"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "value",
        "count",
        "finished",
        "target",
        "direction",
        "weekly"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "done_unassisted": {
      "$ref": "#/$defs/rate_metric"
    },
    "permission_asks": {
      "$ref": "#/$defs/metric"
    },
    "questions_asked": {
      "$ref": "#/$defs/metric"
    },
    "criteria_failed": {
      "$ref": "#/$defs/metric"
    },
    "cards": {
      "type": "integer",
      "minimum": 0
    },
    "backfilled": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "done_unassisted",
    "permission_asks",
    "questions_asked",
    "criteria_failed",
    "cards",
    "backfilled"
  ],
  "additionalProperties": false
}
