#!/usr/bin/env python3
"""Fake `claude` CLI for hermetic tests: replays scripted stream-json turns.

Scripts live in $FAKE_CLAUDE_DIR/<key>/NNN.jsonl and are consumed in name order; key is the first 8 chars
of the run dir name (a worktree is `<root>/<id8>-<n>/wt`), falling back to $FAKE_CLAUDE_DIR/default/. With no
script left it replays a plain successful turn ending in a `D:` tag. Every call is appended to
$FAKE_CLAUDE_DIR/calls.jsonl (argv, cwd, prompt, resume, model, CLAUDE_AUTO_CONTINUE, bg_wait).

A script line is either a raw stream-json object (printed with the session id filled in) or a directive
{"_fake": kind}: text, tool, tool_result, denied, result (optional `denials`), limit, write, sleep, spawn_sleeper, shell (a
bash child for `sec` seconds, as a background Bash job), raw, stderr, exit, stdin (replay the next stdin line); a first `bare` line
suppresses the init event and the session id.
"""

import json
import os
import subprocess
import sys
import time
import uuid
from pathlib import Path

DEFAULT = [
    {"_fake": "text", "text": "Did the thing."},
    {"_fake": "result", "text": "Did the thing.\n\nD: done"},
]


def parse(argv: list[str]) -> dict[str, str | None]:
    """Pick the prompt (after -p), --resume and --model out of argv."""
    opts: dict[str, str | None] = {"prompt": None, "resume": None, "model": None, "effort": None}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "-p" and i + 1 < len(argv):
            opts["prompt"] = argv[i + 1]
            i += 2
        elif arg in ("--resume", "--model", "--effort") and i + 1 < len(argv):
            opts[arg[2:]] = argv[i + 1]
            i += 2
        else:
            i += 1
    return opts


def next_script(base: Path, key: str) -> list[dict]:
    """Pop the first unused script for this key (or default); the built-in turn when none is left."""
    for folder in (base / key, base / "default"):
        files = sorted(folder.glob("*.jsonl")) if folder.is_dir() else []
        for script in files:
            claimed = script.with_suffix(".used")
            try:  # rename is the atomic claim: of two parallel turns exactly one wins each script
                script.rename(claimed)
            except FileNotFoundError:
                continue
            text = claimed.read_text(encoding="utf-8")
            return [json.loads(line) for line in text.splitlines() if line.strip()]
    return DEFAULT


def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def run(step: dict, sid: str, cwd: Path) -> int | None:
    """Play one script line; return an exit code to stop early."""
    kind = step.get("_fake")
    if kind is None:
        emit({**step, "session_id": sid})
    elif kind == "text":
        emit({"type": "assistant", "message": {"content": [{"type": "text", "text": step["text"]}]}, "session_id": sid})
    elif kind == "tool":
        block = {"type": "tool_use", "id": step.get("id", "toolu_fake"), "name": step["name"], "input": step.get("input", {})}
        emit({"type": "assistant", "message": {"content": [block]}, "session_id": sid})
    elif kind == "tool_result":
        block = {"type": "tool_result", "tool_use_id": step["id"], "content": step.get("text", ""), "is_error": step.get("error", False)}
        emit({"type": "user", "message": {"content": [block]}, "session_id": sid})
    elif kind == "denied":
        emit({"type": "system", "subtype": "permission_denied", "tool_name": step["tool"], "tool_use_id": step["id"],
              "decision_reason_type": step.get("reason", "rule"), "session_id": sid})
    elif kind == "result":
        emit({
            "type": "result", "subtype": "success", "is_error": step.get("is_error", False), "result": step["text"],
            "session_id": sid, "total_cost_usd": step.get("cost", 0.01), "num_turns": 1,
            "permission_denials": step.get("denials", []),
            "modelUsage": step.get("model_usage", {"fake-model": {"costUSD": step.get("cost", 0.01)}}),
        })
    elif kind == "limit":
        info = {"status": step.get("status", "rejected"), "resetsAt": step["resets_at"], "rateLimitType": "five_hour",
                "overageStatus": "rejected", "isUsingOverage": step.get("using_overage", False)}
        emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": sid})
    elif kind == "write":
        target = cwd / step["path"]
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(step["text"], encoding="utf-8")
    elif kind == "sleep":
        time.sleep(step["sec"])
    elif kind == "spawn_sleeper":
        child = subprocess.Popen(["sleep", "30"])
        Path(step["pidfile"]).write_text(str(child.pid), encoding="utf-8")
    elif kind == "shell":  # `; :` keeps bash alive: a lone command is exec-replaced
        subprocess.run(["bash", "-c", f"sleep {step['sec']}; :"], check=False)
    elif kind == "raw":
        sys.stdout.write(step["text"] + "\n")
        sys.stdout.flush()
    elif kind == "stderr":
        sys.stderr.write(step["text"] + "\n")
        sys.stderr.flush()
    elif kind == "exit":
        return int(step["code"])
    elif kind == "stdin":  # wait for a peer line on stdin and replay it, as --replay-user-messages does
        line = sys.stdin.readline()
        if line:
            emit({**json.loads(line), "isReplay": True, "session_id": sid})
    return None


STDIN_FLAGS = ("--input-format", "stream-json", "--replay-user-messages")


def stdin_prompt(argv: list[str]) -> list[str]:
    """A peer-mode turn (runner/peerpipe.py) reads its prompt as the first stdin line: put it back after -p."""
    if "--input-format" not in argv:
        return argv
    first = json.loads(sys.stdin.readline() or "{}")
    rest = [a for a in argv if a not in STDIN_FLAGS]
    at = rest.index("-p") + 1
    return [*rest[:at], str(first.get("message", {}).get("content", "")), *rest[at:]]


def main() -> int:
    base = Path(os.environ["FAKE_CLAUDE_DIR"])
    argv = stdin_prompt(sys.argv[1:])
    opts = parse(argv)
    cwd = Path.cwd()
    call = {"argv": argv, "cwd": str(cwd), **opts, "via_stdin": argv != sys.argv[1:], "auto_continue": os.environ.get("CLAUDE_AUTO_CONTINUE"),
            "bg_wait": os.environ.get("CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS"),
            "api_key": "ANTHROPIC_API_KEY" in os.environ, "via_sdk": os.environ.get("FAKE_VIA_SDK") == "1",
            "phone_owner": os.environ.get("PHONE_LEASE_OWNER")}
    with (base / "calls.jsonl").open("a", encoding="utf-8") as log:
        log.write(json.dumps(call) + "\n")
    name = cwd.parent.name if cwd.name == "wt" else cwd.name
    key = name if "children" in cwd.parts else name[:8]  # umbrella children share the umbrella's id8: keep the -<n>
    steps = next_script(base, key)
    bare = steps[0].get("_fake") == "bare"
    sid = "" if bare else opts["resume"] or f"fake-{uuid.uuid4().hex[:8]}"
    if not bare:
        emit({"type": "system", "subtype": "init", "session_id": sid, "model": opts["model"], "cwd": str(cwd)})
    for step in steps[1:] if bare else steps:
        code = run(step, sid, cwd)
        if code is not None:
            return code
    return 0


if __name__ == "__main__":
    sys.exit(main())
