#!/usr/bin/env python3
"""Fake `adb` for hermetic tests: `adb devices` lists the serials in $FAKE_ADB_DIR/devices.

Each line of that file is `<serial> <state>` (state defaults to `device`). Every call is appended to
$FAKE_ADB_DIR/calls. A file named `hang` there makes the call sleep (to exercise the caller's timeout).
Any subcommand other than `devices` is refused, so a test can never drive a real or fake phone by accident.
"""

import os
import sys
import time
from pathlib import Path


def main() -> int:
    base = Path(os.environ["FAKE_ADB_DIR"])
    with (base / "calls").open("a", encoding="utf-8") as log:
        log.write(" ".join(sys.argv[1:]) + "\n")
    if (base / "hang").exists():
        time.sleep(30)
    if sys.argv[1:] != ["devices"]:
        sys.stderr.write("fake adb: only `devices` is supported\n")
        return 2
    sys.stdout.write("List of devices attached\n")
    listed = base / "devices"
    for line in listed.read_text(encoding="utf-8").splitlines() if listed.exists() else []:
        serial, _, state = line.partition(" ")
        sys.stdout.write(f"{serial}\t{state or 'device'}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
