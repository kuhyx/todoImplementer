---
import "@kuhyx/web-ui/tokens.css";
import "@/styles/base.css";
import "@/sessions/css/sessions.css";
import "@/sessions/css/toolbar.css";
import "@/sessions/css/table.css";
import "@/issues/css/issues.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="todoimpl-csrf" content="__TODOIMPL_CSRF__" />
    <meta name="todoimpl-build" content="__TODOIMPL_BUILD__" />
    <meta name="todoimpl-build-name" content="__TODOIMPL_BUILD__" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#211d1b" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>Issues - todoImplementer</title>
  </head>
  <body>
    <issues-app></issues-app>
    <noscript><p>The issue log needs JavaScript.</p></noscript>
    <script>
      import { boot } from "@/issues/boot";

      boot();
    </script>
  </body>
</html>
