--- a/features/publish_caddy_site.sh
+++ b/features/publish_caddy_site.sh
@@ -5,6 +5,9 @@
 #
 #   publish_caddy_site.sh <name> <port>            # write snippet, validate, reload
 #   publish_caddy_site.sh <name> <port> --dry-run  # validate only, change nothing
+#   publish_caddy_site.sh <name> <port> --forward-auth <host:port>
+#       # gate every request through oauth2-proxy at <host:port> (/oauth2/auth);
+#       # /oauth2/* goes to the proxy. Replaces the bearer gate. Options combine.
 #
 # Optional bearer gate: if ~/.config/<name>-mcp/token exists (or TOKEN_FILE),
 # requests without "Authorization: Bearer <token>" get 401 at the edge.
@@ -20,8 +23,25 @@
 	exit 1
 }
 
-[[ $# -ge 2 ]] || die "usage: $0 <name> <port> [--dry-run]"
-readonly NAME="$1" PORT="$2" MODE="${3:-}"
+[[ $# -ge 2 ]] || die "usage: $0 <name> <port> [--dry-run] [--forward-auth <host:port>]"
+NAME="$1" PORT="$2"
+shift 2
+MODE="" FORWARD_AUTH=""
+while (($#)); do
+	case "$1" in
+	--dry-run) MODE="--dry-run" ;;
+	--forward-auth)
+		[[ $# -ge 2 ]] || die "--forward-auth needs <host:port>"
+		FORWARD_AUTH="$2"
+		shift
+		;;
+	*) die "unknown option: $1" ;;
+	esac
+	shift
+done
+readonly NAME PORT MODE FORWARD_AUTH
+[[ -z "$FORWARD_AUTH" || "$FORWARD_AUTH" =~ ^[A-Za-z0-9.-]+:[0-9]{2,5}$ ]] ||
+	die "bad --forward-auth upstream: $FORWARD_AUTH"
 [[ "$NAME" =~ ^[a-z0-9-]+$ ]] || die "bad name: $NAME"
 [[ "$PORT" =~ ^[0-9]{4,5}$ ]] || die "bad port: $PORT"
 command -v docker >/dev/null || die "docker is required"
@@ -30,9 +50,22 @@
 readonly HOST="${NAME}.kuhy.duckdns.org"
 readonly TOKEN_FILE="${TOKEN_FILE:-${HOME}/.config/${NAME}-mcp/token}"
 
+# Google/oauth2-proxy gate: /oauth2/* -> proxy, everything else must pass /oauth2/auth.
+render_forward_auth() {
+	printf '\thandle /oauth2/* {\n\t\treverse_proxy %s {\n\t\t\theader_up X-Real-IP {remote_host}\n\t\t}\n\t}\n' "$FORWARD_AUTH"
+	printf '\thandle {\n\t\tforward_auth %s {\n\t\t\turi /oauth2/auth\n' "$FORWARD_AUTH"
+	printf '\t\t\theader_up X-Real-IP {remote_host}\n\t\t\t@unauth status 401\n'
+	printf '\t\t\thandle_response @unauth {\n\t\t\t\tredir * /oauth2/sign_in?rd={scheme}://{host}{uri}\n\t\t\t}\n\t\t}\n'
+	printf '\t\treverse_proxy 127.0.0.1:%s {\n\t\t\tflush_interval -1\n\t\t}\n\t}\n}\n' "$PORT"
+}
+
 render() {
 	echo "# Managed by publish_caddy_site.sh -- do not edit by hand."
 	echo "${HOST} {"
+	if [[ -n "$FORWARD_AUTH" ]]; then
+		render_forward_auth
+		return
+	fi
 	if [[ -f "$TOKEN_FILE" ]]; then
 		printf '\t@unauth not header Authorization "Bearer %s"\n' "$(<"$TOKEN_FILE")"
 		printf '\trespond @unauth "unauthorized" 401\n'
