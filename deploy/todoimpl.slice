# Every todoImplementer board unit (claude turns, gates, deploys, and the services sessions start with
# `systemd-run --slice=todoimpl.slice`) shares this one cap, so ~30 sessions building at once can no longer
# swap the whole PC into a freeze (T1982, 2026-11-11). Sized for 30 GiB RAM / 24 threads: the desktop keeps
# >= 12 GiB RAM and 8 threads. MemorySwapMax is the setting that stops thrash: past RAM + 8 GiB swap the
# kernel OOM-kills inside this slice (a turn dies and the board's retry ladder resumes it) instead of
# freezing the machine. No MemoryHigh (T2400): on 2026-11-20 its throttling froze every card in the slice for
# 47 min behind one card's 16 GB render. Each card has its own hard cap one level down
# (todoimpl-.slice.d/, runner/cardslice.py). Installed by scripts/deploy.sh; units pick it up via --slice.
[Unit]
Description=todoImplementer board sessions (memory, swap and CPU capped)

[Slice]
MemoryMax=18G
MemorySwapMax=8G
CPUQuota=1600%
CPUWeight=20
TasksMax=8192
